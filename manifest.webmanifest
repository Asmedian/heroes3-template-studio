{
  "id": "./",
  "name": "Heroes III Template Studio",
  "short_name": "H3 Templates",
  "description": "Offline visual editor and converter for Heroes of Might and Magic III RMG templates: Shadow of Death, HotA 1.7 and HotA 1.8.",
  "lang": "ru",
  "dir": "ltr",
  "version": "1.0.1",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#111827",
  "theme_color": "#111827",
  "categories": [
    "productivity",
    "utilities",
    "games"
  ],
  "icons": [
    {
      "src": "./public/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./public/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./public/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
